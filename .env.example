# Copy to .env and fill in as sponsor signups complete.
# Every lane is optional — blue agent degrades to heuristic-only mode.

CLICKHOUSE_URL=http://parry:parry-local@localhost:8123
# For the ClickHouse Cloud mirror (sponsor credits), point this at the cloud
# endpoint instead: https://<user>:<pass>@<instance>.clickhouse.cloud:8443

# AkashML — https://akashml.com (Settings -> API Keys)
AKASHML_API_KEY=
AKASHML_MODEL=openai/gpt-oss-20b

# Senso — https://docs.senso.ai (dashboard -> + New key, starts tgr_)
SENSO_API_KEY=

# Guild.ai — console API trigger for the published parry-commander agent
GUILD_KEY_ID=
GUILD_KEY_SECRET=
GUILD_SESSIONS_URL=   # https://api.guild.ai/v1/workspaces/<owner>/<ws>/sessions

# Actions
ENABLE_BLOCK=1
BLOCK_AFTER=cmdinj,sqli-dump
ENABLE_PR=0            # 1 after `gh auth login`
GITHUB_REPO=           # e.g. yourname/parry
